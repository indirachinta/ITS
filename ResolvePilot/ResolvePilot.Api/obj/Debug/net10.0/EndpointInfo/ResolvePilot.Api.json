{
  "openapi": "3.0.4",
  "info": {
    "title": "ResolvePilot.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/incidents/resolve": {
      "post": {
        "tags": [
          "Incidents"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResolutionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolutionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolutionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IncidentRequest": {
        "required": [
          "affectedService",
          "severity",
          "summary",
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "affectedService": {
            "type": "string",
            "nullable": true
          },
          "severity": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "$ref": "#/components/schemas/ResolutionMode"
          }
        },
        "additionalProperties": false
      },
      "InvestigationFindings": {
        "type": "object",
        "properties": {
          "workflowName": {
            "type": "string",
            "nullable": true
          },
          "rootCauseHypothesis": {
            "type": "string",
            "nullable": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RecommendedTool": {
        "required": [
          "confidence",
          "reasoning",
          "score",
          "source",
          "toolName"
        ],
        "type": "object",
        "properties": {
          "toolName": {
            "type": "string",
            "nullable": true
          },
          "score": {
            "type": "number",
            "format": "double"
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "source": {
            "type": "string",
            "nullable": true
          },
          "reasoning": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResolutionMode": {
        "enum": [
          "Auto",
          "Fast",
          "Deep"
        ],
        "type": "string"
      },
      "ResolutionResponse": {
        "required": [
          "affectedService",
          "confidence",
          "decisionSource",
          "incidentIntent",
          "reasoning",
          "recommendedAction",
          "recommendedTools",
          "resolutionPath",
          "resolutionSummary",
          "toolsExecuted",
          "workflowRequired"
        ],
        "type": "object",
        "properties": {
          "incidentIntent": {
            "type": "string",
            "nullable": true
          },
          "affectedService": {
            "type": "string",
            "nullable": true
          },
          "resolutionPath": {
            "type": "string",
            "nullable": true
          },
          "recommendedTools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecommendedTool"
            },
            "nullable": true
          },
          "toolsExecuted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "resolutionSummary": {
            "type": "string",
            "nullable": true
          },
          "recommendedAction": {
            "type": "string",
            "nullable": true
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "reasoning": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "workflowRequired": {
            "type": "boolean"
          },
          "investigationFindings": {
            "$ref": "#/components/schemas/InvestigationFindings"
          },
          "decisionSource": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Incidents"
    }
  ]
}